# Development only. Set real deployment values before exposing the application.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://battles:replace-this-password@127.0.0.1:5432/battles
TEST_DATABASE_URL=postgresql://battles:replace-this-password@127.0.0.1:5432/battles_test
POSTGRES_PASSWORD=replace-this-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Explicitly opt in to example battles/packages and a demo player in development.
DEMO_MODE=false
# Production uses Secure cookies. Set TRUST_PROXY=1 only behind one trusted proxy.
TRUST_PROXY=0
INITIAL_COINS=1000
SESSION_DAYS=7
